{
  "manifest_version": 3,
  "name": "EMRY - Eternal Memory",
  "version": "2.0.0",
  "description": "Capture your AI conversations across ChatGPT, Claude, Gemini, and more. Never forget a conversation.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://perplexity.ai/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EMRY - Eternal Memory",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content/universal.js", "content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": ["content/universal.js", "content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://bard.google.com/*"
      ],
      "js": ["content/universal.js", "content/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://perplexity.ai/*"
      ],
      "js": ["content/universal.js", "content/perplexity.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
